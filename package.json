{
  "name": "vscode-markdown-refactor",
  "displayName": "Markdown Refactor",
  "description": "Refactor Markdown with extract, spacing, and punctuation conversion actions.",
  "version": "0.3.4",
  "publisher": "zedware",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/zedware/vscode-markdown-refactor.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:markdown",
    "onCommand:markdownRefactor.showActions",
    "onCommand:markdownRefactor.extractSelectionToFile",
    "onCommand:markdownRefactor.spaceCjkAndEnglish",
    "onCommand:markdownRefactor.spaceCjkAndEnglishWithPunctuation",
    "onCommand:markdownRefactor.convertPunctuationToFullWidth",
    "onCommand:markdownRefactor.convertPunctuationToHalfWidth",
    "onCommand:markdownRefactor.cycleTaskCheckbox",
    "onCommand:markdownRefactor.installMarkdownPreviewEnhancedSupport",
    "onCommand:markdownRefactor.insertTimestamp"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "markdown.markdownItPlugins": true,
    "markdown.previewStyles": [
      "media/checkbox.css"
    ],
    "commands": [
      {
        "command": "markdownRefactor.insertTimestamp",
        "title": "Markdown: Insert Timestamp",
        "category": "Markdown"
      },
      {
        "command": "markdownRefactor.showActions",
        "title": "Markdown: Refactor...",
        "category": "Markdown"
      },
      {
        "command": "markdownRefactor.extractSelectionToFile",
        "title": "Markdown: Extract Selection to File",
        "category": "Markdown"
      },
      {
        "command": "markdownRefactor.spaceCjkAndEnglish",
        "title": "Markdown: Space CJK, English, and Numbers",
        "category": "Markdown"
      },
      {
        "command": "markdownRefactor.spaceCjkAndEnglishWithPunctuation",
        "title": "Markdown: Space CJK, English, Numbers, and Punctuation",
        "category": "Markdown"
      },
      {
        "command": "markdownRefactor.convertPunctuationToFullWidth",
        "title": "Markdown: Convert Punctuation to Full Width",
        "category": "Markdown"
      },
      {
        "command": "markdownRefactor.convertPunctuationToHalfWidth",
        "title": "Markdown: Convert Punctuation to Half Width",
        "category": "Markdown"
      },
      {
        "command": "markdownRefactor.cycleTaskCheckbox",
        "title": "Markdown: Cycle Task Checkbox",
        "category": "Markdown"
      },
      {
        "command": "markdownRefactor.unifyListFormat",
        "title": "Markdown: Unify List Format",
        "category": "Markdown"
      },
      {
        "command": "markdownRefactor.unifyTrailingPunctuation",
        "title": "Markdown: Unify Trailing Punctuation",
        "category": "Markdown"
      },
      {
        "command": "markdownRefactor.installMarkdownPreviewEnhancedSupport",
        "title": "Markdown: Install Markdown Preview Enhanced Support",
        "category": "Markdown"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "markdownRefactor.showActions",
          "when": "editorLangId == markdown",
          "group": "1_modification"
        }
      ],
      "commandPalette": [
        {
          "command": "markdownRefactor.insertTimestamp",
          "when": "editorLangId == markdown"
        },
        {
          "command": "markdownRefactor.showActions",
          "when": "editorLangId == markdown"
        },
        {
          "command": "markdownRefactor.extractSelectionToFile",
          "when": "editorLangId == markdown && editorHasSelection"
        },
        {
          "command": "markdownRefactor.spaceCjkAndEnglish",
          "when": "editorLangId == markdown"
        },
        {
          "command": "markdownRefactor.spaceCjkAndEnglishWithPunctuation",
          "when": "editorLangId == markdown"
        },
        {
          "command": "markdownRefactor.convertPunctuationToFullWidth",
          "when": "editorLangId == markdown"
        },
        {
          "command": "markdownRefactor.convertPunctuationToHalfWidth",
          "when": "editorLangId == markdown"
        },
        {
          "command": "markdownRefactor.cycleTaskCheckbox",
          "when": "editorLangId == markdown"
        },
        {
          "command": "markdownRefactor.unifyListFormat",
          "when": "editorLangId == markdown && editorHasSelection"
        },
        {
          "command": "markdownRefactor.unifyTrailingPunctuation",
          "when": "editorLangId == markdown && editorHasSelection"
        },
        {
          "command": "markdownRefactor.installMarkdownPreviewEnhancedSupport"
        }
      ]
    },
    "keybindings": [
      {
        "command": "markdownRefactor.showActions",
        "key": "ctrl+alt+m",
        "mac": "cmd+alt+m",
        "when": "editorLangId == markdown"
      },
      {
        "command": "markdownRefactor.cycleTaskCheckbox",
        "key": "ctrl+alt+w",
        "mac": "cmd+alt+w",
        "when": "editorLangId == markdown"
      }
    ],
    "configuration": {
      "title": "Markdown Refactor",
      "properties": {
        "markdownRefactor.linkStyle": {
          "type": "string",
          "enum": [
            "markdown",
            "embed",
            "wiki"
          ],
          "default": "markdown",
          "description": "Replacement style after extraction: markdown link, Markdown image/embed link, or wiki link."
        },
        "markdownRefactor.defaultDirectory": {
          "type": "string",
          "default": "",
          "description": "Optional directory, relative to the current file, where extracted Markdown files are created."
        },
        "markdownRefactor.checkboxCycle": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(\\[[^\\]\\r\\n]*\\]|\\S+)$"
          },
          "uniqueItems": true,
          "minItems": 2,
          "default": [
            "⬜",
            "⏳",
            "✅",
            "❌",
            "❗"
          ],
          "description": "Ordered task marker states used by Markdown: Cycle Task Checkbox. Use bracketed markers or compact emoji/text markers without spaces."
        },
        "markdownRefactor.decorateCheckboxes": {
          "type": "boolean",
          "default": true,
          "description": "Highlight configured Markdown task checkbox states in the editor."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^20.14.10",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.5.3"
  }
}
